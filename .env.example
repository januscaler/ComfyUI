# Copy to .env and adjust per machine:  cp .env.example .env
# All values are optional — the compose falls back to these defaults.

# Directory that holds ComfyUI model weights (diffusion_models/, text_encoders/,
# vae/, ...), mounted at /opt/ComfyUI/models. Point this at a shared model
# store to reuse downloads across projects (use a real model dir, not the
# huggingface cache dir).
#MODELS_DIR=~/VoxMin/ace-step/models

# GB of VRAM DynamicVRAM keeps free for the OS/other apps. Raise on a desktop
# with a display attached, lower for a headless box.
#VRAM_HEADROOM_GB=2

# Number of async weight-offload streams (overlaps RAM<->VRAM transfers with
# compute). NVIDIA default is 2.
#ASYNC_OFFLOAD_STREAMS=2

# Hugging Face token, required to download gated models (e.g. FLUX.2 klein 9B).
#HF_TOKEN=

# Extra ComfyUI CLI flags appended to the server command, e.g. --listen / --port
#COMFYUI_ARGS=--port 8288
